skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBorderColor #40546A
skinparam classBackgroundColor<<boundary>> #E5F4EB
skinparam classBackgroundColor<<control>> #FFF1D6
skinparam classBackgroundColor<<entity>> #EAF2FC
skinparam classBackgroundColor<<container>> #E3F1D3
skinparam classBackgroundColor<<strategy>> #F9E4F0
skinparam classBackgroundColor<<infrastructure>> #F0F2F5
skinparam classBackgroundColor<<active>> #EEE8FA
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FAFBFD
skinparam packageBorderColor #CBD5E1
skinparam ArrowColor #526579
skinparam ArrowFontSize 12
